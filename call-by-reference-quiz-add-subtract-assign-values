#include <stdio.h>
int sum(int *a, int *b)
{
    *a = 67 + 55;
    *b = 67 - 55;
}

int main()
{
    int a, b;
    a = 67;
    b = 55;
    printf("The value of a is %d\n", a);
    printf("And the value of b is %d\n", b);
    sum(&a, &b);
    printf("Now the value of a is %d\n", a);
    printf("And The value of b is %d", b);

    return 0;
}
